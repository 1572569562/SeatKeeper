# 复制为 .env 后替换所有 CHANGE_ME 占位值，禁止提交 .env。
MYSQL_PORT=3307
MYSQL_DATABASE=seatkeeper
MYSQL_USER=seatkeeper
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
# DB_USER / DB_PASSWORD 必须与上面的应用账号保持一致。
DB_URL=jdbc:mysql://127.0.0.1:3307/seatkeeper?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USER=seatkeeper
DB_PASSWORD=CHANGE_ME_APP_PASSWORD
# 可选：本机 mysql.exe / mysqldump.exe 目录；已加入 PATH 时可删除本行。
MYSQL_BIN=
